# ── Application ──────────────────────────────────────────────
APP_NAME=MyoCortex
APP_VERSION=1.0.0
APP_DEBUG=false

# ── PubMed ────────────────────────────────────────────────────
PUBMED_EMAIL=your@email.com
PUBMED_API_KEY=
PUBMED_MAX_RESULTS=15
PUBMED_RETRY_ATTEMPTS=3
PUBMED_RETRY_WAIT=1.0

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── FAISS ─────────────────────────────────────────────────────
FAISS_TOP_K=12

# ── Multi-query retrieval ─────────────────────────────────────
QUERY_EXPANSION_N=6
MULTI_QUERY_MAX_PAPERS=80

# ── Cache ─────────────────────────────────────────────────────
# Options: memory | sqlite
CACHE_BACKEND=memory
CACHE_DB_PATH=myocortex_cache.db

# ── LLM (choose one backend) ──────────────────────────────────
# Options: groq | hf_api | mock
LLM_BACKEND=groq

# Groq (free, fast — get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=llama-3.3-70b-versatile

# HuggingFace Inference API fallback (free at https://huggingface.co/settings/tokens)
HF_API_TOKEN=your_huggingface_token_here
HF_API_MODEL_ID=katanemo/Arch-Router-1.5B
